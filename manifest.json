{
  "id": "com.benrossi.carboncopysimulator",
  "name": "Carbon Copy Simulator",
  "version": "0.1.0",
  "main": "main.js",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "23.3.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "command",
      "id": "runCarbonCopy",
      "label": {
        "default": "Run Carbon Copy Simulation"
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
