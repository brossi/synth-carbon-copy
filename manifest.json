{
  "id": "com.benrossi.carboncopysimulator",
  "name": "Carbon Copy Simulator",
  "version": "0.1.0",
  "main": "main.js",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "27.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "command",
      "id": "runCarbonCopy",
      "label": {
        "default": "Run Carbon Copy Simulation"
      }
    }
  ],
  "requiredPermissions": [
    {
      "name": "localFileSystem",
      "reason": "To access configuration files, presets, textures, and process batch folders"
    },
    {
      "name": "launchProcess",
      "reason": "To perform batch processing operations"
    }
  ]
}
